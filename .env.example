# Existing public settings: recover your original values privately.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CHECKOUT_URL=

# Disabled until ALL deployment settings/tests are complete. No old Pixel runs.
META_TRACKING_ENABLED=false
# Set to the currently supported Graph API version after checking Meta docs.
# Candidate v26.0; official docs returned 429 during this audit (2026-11-05).
META_GRAPH_API_VERSION=v26.0
# Generate: openssl rand -hex 32 (private, no NEXT_PUBLIC_ prefix)
META_SIGNING_SECRET=
# Shared Upstash-compatible Redis REST storage, required in production.
META_REDIS_REST_URL=
META_REDIS_REST_TOKEN=
# Local development ONLY; never used in production.
META_DEV_MEMORY_STORE=false

META_AUTOCAD_PIXEL_ID=987224667726544
META_AUTOCAD_ACCESS_TOKEN=
META_AUTOCAD_ORIGINS=http://localhost:3000
META_AUTOCAD_PATHS=/autocad_master
META_AUTOCAD_TEST_EVENT_CODE=

